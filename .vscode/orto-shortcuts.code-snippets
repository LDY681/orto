	// Place your orto workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	//
	// You can also restrict snippets to specific files using include/exclude patterns:
	// "Test snippet": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "test",
	// 	"body": "test('$1', () => {\n\t$0\n});",
	// 	"include": ["**/*.test.ts", "*.spec.ts"],
	// 	"exclude": ["**/temp/*.ts"],
	// 	"description": "Insert test block"
	// }

	"Links to here": {
		"prefix": "here",
		"body": [
			"<a className=\"text-primary-400 underline\" target=\"_blank\" href=\"${1:URL}\">[here]</a>"
		],
		"description": "Insert a link as [here]",
		"include": ["**/*.mdx"]
	},
	"Links to anywhere": {
		"prefix": "link",
		"body": [
			"<a className=\"text-primary-400 underline\" target=\"_blank\" href=\"${1:URL}\">${2:Text}</a>"
		],
		"description": "Insert a link as [${2:Text}]",
		"include": ["**/*.mdx"]
	},
	"Publication": {
		"prefix": "pub",
		"body": [
			"---",
			"authors: ''",
			"date: 'YYYY-MM-DD'",
			"year: YYYY",
			"topics: ['','']",
			"draft: true/false",
			"doi: ''",
			"pmid: ''",
			"---",
			"",
			""
		],
		"description": "Insert a publication",
		"include": ["**/*.mdx"]
	},
	"Resource": {
		"prefix": "res",
		"body": [
			"---",
			"title: ''",
			"date: 'YYYY-MM-DD'",
			"topics: ['','']",
			"category: ''",
			"draft: true/false",
			"---",
			"",
			""
		],
		"description": "Insert a resource",
		"include": ["**/*.mdx"]
	},
	"Author": {
		"prefix": "aut",
		"body": [
			"---",
			"name: ",
			"avatar: /static/images/avatars/avatar_name.jpg",
			"occupation: ",
			"company: ",
			"role: member/collaborator",
			"---",
			"",
			""
		],
		"description": "Insert an author",
		"include": ["**/*.mdx"]
	},
	"Blog": {
		"prefix": "blog",
		"body": [
			"---",
			"title: ",
			"date: 'YYYY-MM-DD'",
			"draft: true/false",
			"layout: PostBanner/PostSimple/PostBanner",
			"summary: ",
			"---",
			"",
			""
		],
		"description": "Insert a blog post",
		"include": ["**/*.mdx"]
	}

